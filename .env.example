APP_MODE=demo
# demo | local | supabase
# Production refuses to boot when APP_MODE is unset.
# Demo mode ignores API keys and will not open DATABASE_URL.

# Local owner gate. Required for APP_MODE=local.
OWNER_ID=
OWNER_EMAIL=
OWNER_PASSWORD=
SESSION_SECRET=

# Supabase Auth plus the Postgres connection string. Do not put a service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=

# mock | openai. Demo mode always uses the labeled mock provider.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_ANSWER_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# The pgvector column is vector(256). Leave this at 256.
EMBEDDING_DIMENSIONS=256

# Optional local PGlite directory. Demo defaults to .data/demo.
PGLITE_DIR=
INLINE_WORKER=true

CONTEXT_CHUNK_LIMIT=8
CONTEXT_CHAR_LIMIT=12000
OUTPUT_TOKEN_LIMIT=1200
CAPTURE_LIMIT_PER_HOUR=30
AI_LIMIT_PER_HOUR=20
